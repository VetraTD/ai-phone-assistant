# Required: Gemini API key (https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# Required: Full public URL of your server (e.g. https://your-ngrok-id.ngrok.io) - Twilio uses this for webhook action/redirect URLs
BASE_URL=

# Required when Twilio signature validation is enabled (see below)
TWILIO_AUTH_TOKEN=

# Set to false to disable Twilio webhook signature validation (e.g. for local testing without signed requests)
# Default: validation enabled. Use false only in dev.
#
# THIS ALSO GOVERNS THE MEDIA-STREAM WEBSOCKET (ledger P10). /twilio/media-stream
# used to accept ANY upgrade — no signature, no token — so anyone who knew the
# URL could open a call against any tenant they could name, spending Deepgram,
# Gemini and ElevenLabs credit and consuming the measured 10-concurrent
# ElevenLabs cap that real callers share. It now requires a per-call token minted
# by /twilio/voice. Setting this to false turns BOTH controls off, deliberately:
# they answer the same question, and it must not be possible to disable one
# while believing the other still holds. The boot log says which way it is set.
TWILIO_VALIDATE_SIGNATURE=
# Optional. Signing key for the media-stream per-call token. Leave UNSET in
# normal operation: the key is derived from TWILIO_AUTH_TOKEN via HMAC with a
# fixed label, so there is nothing extra to provision and it cannot ship
# half-configured. Set this only to rotate the media-stream credential without
# touching the Twilio one.
MEDIA_STREAM_SECRET=

# Timezone for date/time awareness in AI responses (default: America/Chicago)
TIMEZONE=America/Chicago

# Phone number (E.164) to dial when caller asks for a real person (optional — transfer disabled if missing)
TRANSFER_NUMBER=

# Maximum call duration in minutes before automatic hangup (default: 30)
CALL_MAX_DURATION_MINUTES=30

# Required: Deepgram API key for real-time STT via Media Streams. The server fails
# fast at boot if this is missing — there is no TwiML webhook fallback mode.
DEEPGRAM_API_KEY=

# Set to exactly "true" to enable the debug routes (GET /api/debug/latency,
# POST /api/debug/latency/reset, GET /api/debug/probe-results) and the
# /twilio/probe-stream websocket. Everything 404s when unset.
DEBUG_ENDPOINTS=
# Shared secret required IN ADDITION to DEBUG_ENDPOINTS. Fails closed: with no
# token set, the routes stay 404 even when DEBUG_ENDPOINTS=true. Needed because
# a measurement run enables these on a public host. Unset both when done.
DEBUG_TOKEN=

# --- Latency probe (scripts/latency-probe.js) ------------------------------
# The assistant's own number — the ONLY destination the dialler will call.
ASSISTANT_NUMBER=
# A second Twilio number used to originate the test calls. Must differ from
# ASSISTANT_NUMBER; the two legs cannot bridge otherwise.
PROBE_NUMBER=
# Optional: point the probe at a different host than BASE_URL (e.g. staging).
PROBE_BASE_URL=

# --- TTS A/B candidates (scripts/voice-ab.js) ------------------------------
CARTESIA_API_KEY=
INWORLD_API_KEY=
# Override the ElevenLabs model used for live calls and the A/B baseline.
# Defaults to eleven_flash_v2_5 (services/elevenlabs.js).
ELEVENLABS_MODEL=
# Set to "true" to stop sending previous_text for prosody continuity.
ELEVENLABS_DISABLE_PREVIOUS_TEXT=

# --- Turn-taking tuning (all optional; defaults are in code) ---------------
# Silence required after the caller interrupts before the AI replies. Stops
# the interrupt -> instant-reply -> collide -> interrupt loop. 0 disables.
VOICE_POST_BARGE_SETTLE_MS=
# Self-echo suppression. This pipeline has NO acoustic echo cancellation, so on
# a speakerphone the AI's own voice returns through the caller's mic and was
# being answered as caller speech. "false" disables the guard entirely.
VOICE_ECHO_GUARD=
# How long after playback a transcript can still be treated as echo (ms).
VOICE_ECHO_TAIL_MS=
# Runaway backstop: this many barge-ins inside VOICE_LOOP_BREAKER_WINDOW_MS and
# the AI stops talking until it hears one clean caller utterance. 0 disables.
VOICE_LOOP_BREAKER_BARGES=
VOICE_LOOP_BREAKER_WINDOW_MS=
# Mid-turn silence (ms) before a "still working on that" hold line plays —
# covers slow tool rounds, which are otherwise dead air. 0 disables.
VOICE_LLM_STALL_MS=
# Silence (ms) after the caller stops before a hold line plays. Default 2500.
#
# This file said 1200 until 2026-08-29 and had been wrong since the revert: 1200
# was tried, derived from the llm_ttfb_ms distribution, and taken back out
# because the timer starts at llm_request — AFTER Deepgram's endpointing — so
# 1200ms of timer is ~1750-1900ms of silence as the caller experiences it,
# against a true_v2v p50 near 2600. It fired ahead of perfectly ordinary
# answers. llm_ttfb_ms also INCLUDES tool round trips, so every booking tripped
# it. The live default in lib/voice/llmTurn.js has been 2500 throughout.
#
# This is PERCEIVED latency only — it does not make the model answer sooner.
VOICE_LLM_SLOW_MS=
# Extra LLM turn budget granted per completed tool round, and the ceiling it
# can never pass. 0 grace restores a flat 8s turn budget.
VOICE_LLM_TOOL_GRACE_MS=
VOICE_LLM_HARD_TIMEOUT_MS=
# Outbound tool timeouts. Must stay INSIDE the LLM turn budget above, or a slow
# integration kills its own turn and the caller hears "could you repeat that?"
# instead of the answer.
WEBHOOK_TIMEOUT_MS=
ATHENA_TIMEOUT_MS=

# ElevenLabs streaming TTS (optional — falls back to Google TTS if missing or if the connection fails)
ELEVENLABS_API_KEY=
# Default ElevenLabs voice ID used for streaming TTS when a business has no voice override configured.
ELEVENLABS_DEFAULT_VOICE_ID=

# Google TTS credentials (optional — falls back to Twilio Polly if missing)
# Either set GOOGLE_APPLICATION_CREDENTIALS (path to service account JSON)
# or GOOGLE_TTS_API_KEY (API key).
# GOOGLE_APPLICATION_CREDENTIALS=
# GOOGLE_TTS_API_KEY=

# Sentry DSN for error reporting (optional — disabled if missing)
SENTRY_DSN=

# Notifications (on by default once SMTP or Twilio SMS credentials below are
# configured — no opt-in needed. Set NOTIFICATIONS_ENABLED=false to force
# notifications off even when credentials are present, e.g. for local dev.)
NOTIFICATIONS_ENABLED=
# SMTP for email (e.g. Gmail: enable 2-Step Verification, then create an App Password at myaccount.google.com/apppasswords)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your.email@gmail.com
SMTP_PASS=
SMTP_FROM_EMAIL=
# Twilio SMS: use same account as voice; set TWILIO_SMS_FROM to a number that can send SMS
TWILIO_ACCOUNT_SID=
TWILIO_SMS_FROM=

# CORS — comma-separated origins for dashboard (e.g. http://localhost:5173,https://app.yourdomain.com)
CORS_ORIGIN=

# Athenahealth — two app options (set the one(s) you use)
# Preview: https://api.preview.platform.athenahealth.com | Production: https://api.platform.athenahealth.com
# Platform app: for most clinics (your athena developer portal). Used when integration.config.use_ecc_app is not true.
ATHENA_CLIENT_ID=
ATHENA_CLIENT_SECRET=
ATHENA_API_BASE=https://api.preview.platform.athenahealth.com
ATHENA_TOKEN_URL=https://api.preview.platform.athenahealth.com/oauth2/v1/token
# Practice ID for your clinic (required for athenahealth; also used by scripts/test-appointments.js)
ATHENA_PRACTICE_ID=
# Optional: default department and appointment-type settings (mirror Python sandbox config)
# ATHENA_DEPARTMENT_ID: default department for open slots and appointments when not provided by integration config.
ATHENA_DEPARTMENT_ID=
# ATHENA_APPOINTMENT_TYPE_ID: default appointment type ID when booking/cancelling/rescheduling.
ATHENA_APPOINTMENT_TYPE_ID=
# ATHENA_APPOINTMENT_TYPE_ANY15_ID: ID for a generic 15-minute slot type (used for open slots when present).
ATHENA_APPOINTMENT_TYPE_ANY15_ID=
# ECC app: for ECC only (app in ECC's internal developer portal). Used when integration.config.use_ecc_app is true.
USE_ECC_ATHENA=true
ECC_ATHENA_CLIENT_ID=
ECC_ATHENA_CLIENT_SECRET=
ECC_ATHENA_API_BASE=https://api.preview.platform.athenahealth.com
ECC_ATHENA_TOKEN_URL=https://api.preview.platform.athenahealth.com/oauth2/v1/token

# --- Unrouted calls (dialed number matches no business) --------------------
# A call whose `To` matches no businesses.phone_number row used to be answered
# by the assistant anyway, on a blank default config: it greeted as "our
# office", offered booking that refused at execution, and said "I'll make sure
# they get your message" while persisting nothing and notifying nobody.
# It now forwards to this number, or takes a voicemail when unset.
#
# Deliberately NOT the same as TRANSFER_NUMBER — that is the per-business
# forwarding fallback, and routing a stranger's misrouted call into some other
# business's back office is its own kind of wrong. Must be E.164.
UNROUTED_TRANSFER_NUMBER=

# --- Turn-taking: short-final echo containment -----------------------------
# The AI's own audio can re-enter the caller's mic on a speakerphone. A one-word
# echo like "no" (from "No problem, I can get that booked") is an INTERRUPT_CUE,
# and the main echo guard refuses to classify anything under 4 tokens, so it cut
# callers off. Longest transcript treated as "short" for exact-containment echo
# checks. 0 disables. Default 3.
VOICE_ECHO_SHORT_TOKENS=
# A final shorter than this needs corroborating mic energy. Default 3.
# Was 2, which meant only a ONE-word final was ever doubted — any two-word
# scrap ("uh what") went straight to a barge-in with no VAD check at all.
VOICE_SHORT_FINAL_MIN_WORDS=
# When true, an interrupt cue ("stop", "wait", "no") no longer exempts a short
# final from needing mic energy. Default false — flip only with probe data,
# since a genuine urgent "stop" is what this starts suppressing.
VOICE_CUE_REQUIRES_VOICE=
# --- Turn-taking: false barge-in resistance (the cough fix) -----------------
# Sustained voiced speech required before a SHORT or cue-only transcript may
# interrupt the assistant. Default 250ms.
#
# The VAD latches after 200ms of energy and holds for 300ms, so a cough — a
# ~200ms burst — satisfied "was there voice recently" perfectly, and every
# cheap noise arrived pre-corroborated. Duration is what separates a cough from
# a sentence and nothing was measuring it. Raising this suppresses more noise
# AND starts eating genuine one-word interruptions; a real urgent "stop" is
# around this long. Tune against `npm run sim:cutoff`, which has before/after
# rows for exactly this, not by feel. 0 disables.
VOICE_BARGE_MIN_VOICED_MS=
# How many words a cue-less INTERIM needs before it may cut the assistant off.
# Unset follows VOICE_ECHO_MIN_TOKENS (4), which is the historical behavior and
# changes nothing. 4 words is ~1.2-1.6s of the caller and the assistant talking
# at once, reported from a live test call as "unnatural overlap"; set 2 to close
# that. It is safe to lower ONLY because echoGuard.isShortEcho now runs on the
# interim path — below 4 tokens classify() cannot judge echo at all, and short
# transcripts newly admitted here must also clear the two raised bars below.
# Verify with `npm run sim:cutoff`, which has a row per case including the
# assistant's own words coming back.
VOICE_BARGE_MIN_WORDS=
# The raised bars that make the above safe. They apply ONLY to transcripts the
# word gate newly admits — cue-carrying and full-length transcripts keep the
# normal VOICE_BARGE_MIN_VOICED_MS / VOICE_BARGE_MIN_CONFIDENCE thresholds.
# Defaults 350ms and 0.75, against the normal 250ms and 0.6.
VOICE_BARGE_SHORT_MIN_VOICED_MS=
VOICE_BARGE_SHORT_MIN_CONFIDENCE=
# Minimum Deepgram confidence for a SHORT or cue-only transcript to interrupt.
# Default 0.6. Deepgram reported this all along and the pipeline discarded it.
# Noise forced into the nearest vocabulary item is precisely what a speech
# model is uncertain about. Unknown confidence passes (Deepgram omits it on
# some events, and treating "not reported" as "not confident" would suppress
# real interruptions). 0 disables.
VOICE_BARGE_MIN_CONFIDENCE=
# --- Turn-taking: the greeting is uninterruptible ---------------------------
# Barge-in is disarmed until the greeting finishes. Set to exactly "false" to
# let callers interrupt it as they can everywhere else.
#
# Everywhere else, yielding the floor is right. Here it is not: a cough or a
# speakerphone reflection cuts the business name off the front of the call and
# the caller never learns who answered.
#
# Anything the caller says over the greeting is DISCARDED (counter:
# greeting_speech_discarded), so a caller who talks over it repeats themselves.
# Holding it was tried and is worse: this gate sits above the word-count,
# sustained-voice and confidence checks, so held text is unfiltered — a cough or
# a television became the caller's first turn. Shorten the greeting rather than
# reopen the gate. The mic is NOT muted; only the decision is suppressed.
VOICE_GREETING_UNINTERRUPTIBLE=
# Backstop for the above: reopen the gate this long after the greeting starts
# even if its completion mark never arrives. Default 12000ms, comfortably
# longer than a long custom greeting plus the recording disclosure (~10s). A
# gate that sticks shut would deafen the call for its whole duration, which is
# the one failure of this design a caller cannot recover from — so there are
# two further defences in code (first turn started, call age) that hold even
# if this timer is lost. Fires the counter greeting_guard_expired, which should
# be 0 in production.
VOICE_GREETING_GUARD_MAX_MS=
# Milliseconds of silence played before the greeting, to bring the caller's
# audio path up before the first word rather than with it. Default 500, max
# 2000, 0 disables.
#
# Reported live: the first few words of the greeting are not heard. Nothing in
# this pipeline can cut that audio — barge-in is unreachable while the greeting
# is active — but TwiML returns a bare <Connect><Stream> with no <Say> and no
# <Pause>, so the first byte of audio on the call is the first byte of speech,
# and it is sent the instant ElevenLabs produces sound.
#
# Mostly free rather than added latency: it overlaps the ElevenLabs connect and
# TTFB the call is already waiting on. THE CAUSE IS NOT PROVEN — read
# greeting_audio_timing (firstWireMs vs ttsFirstByteMs) before keeping it. If
# ttsFirstByteMs is reliably larger than this value, the pad covered nothing
# and should be reduced or set to 0.
VOICE_GREETING_PREROLL_MS=
# How long to hold a final that carries no terminal punctuation, i.e. one STT
# closed on a silence gap mid-sentence. Retuned 1500 -> 500 when classifyHold
# stopped being gated behind isIncomplete(). 0 disables.
VOICE_HOLD_NO_PUNCT_MS=

# --- Gemini explicit context caching (COST lever, not latency) -------------
# Implicit caching does not engage on gemini-3.6-flash at all; explicit caching
# does, and cuts the dominant cost line ~75-80% (input is ~93% of the bill).
# MEASURED 2026-08-28 on the real turn path, over two full eval runs: 86.9% and
# 86.7% of prompt tokens served from cache, with ZERO misses in 407 turns.
#
# The older "94%" figure, and the "98.8%" in services/geminiCache.js, were both
# measured against SYNTHETIC FILLER whose dynamic tail is tiny. The real prompt
# has a real tail, so it caches less. That is the whole explanation for figures
# that have contradicted each other across sessions — they measured different
# prompts, not the same prompt differently.
#
# THE REAL NUMBER, measured over ten full eval runs 2026-08-31: 77-78% of prompt
# tokens cached, and 66% off the cost of a run ($0.902 -> $0.307).
#
# TTFT is flat in prompt size — this makes nothing faster.
#
# THE BAND HAS NOW BEEN RUN, and it cleared. 5 runs per arm, arms interleaved,
# judge off. No scenario reached p<0.05 on one-sided Fisher. Mean hard pass 41.0
# OFF vs 39.4 ON — and 40.6 once the after-hours prompt ambiguity it exposed was
# fixed, which is inside a baseline arm that itself spans 39-42. The earlier
# concern that tool calling breaks under a cache was separately disproven with a
# control at 8 trials per arm (uncached 3/8, cached 4/8, indistinguishable).
#
# It still ships OFF so that first live exposure is revertible without a deploy.
# Once live calls look clean, flip the DEFAULT rather than relying on this being
# set — an unset variable on the wrong service is how two previous fixes shipped
# inert. `PIPELINE_V2` is the pattern: on unless explicitly "false".
#
# Watch llm_cache_hits in GET /api/debug/latency once it is on. Flat at zero
# means the provider is refusing to create caches and every call is silently
# paying full price — the failure mode has no other symptom. On Vertex that is
# the EXPECTED state; see GEMINI_CACHE_VERTEX_MIN_CHARS below.
GEMINI_EXPLICIT_CACHE=
# Cache lifetime in seconds (default 900 — deliberately PER-CALL).
#
# Reads bill at $0.075/M vs $0.75/M for fresh input, but storage bills at
# $0.50/M tokens/HOUR whether or not a call comes in. A ~4,200-token prefix on
# a 1h TTL is ~$1.53/month/business and needs ~49 calls/month to break even —
# and the registry is a per-process Map, so that rent is paid once per instance
# on a multi-instance deploy. At 900s a cache costs ~$0.0005 per call and
# breaks even at any volume, while still covering a long call end to end.
#
# Nothing is lost between calls: the key is content-hashed, so a second or
# concurrent call to the same business inside the window reuses the live entry
# for free. Raise this per-tenant only once there is a call-volume figure.
GEMINI_CACHE_TTL_S=
# Trials per arm in scripts/verify-explicit-cache.js's function-calling gate
# (default 5). NOT a runtime setting. It exists because one request per arm is a
# coin flip: at temperature 0 that gate produced "BROKEN" and then its exact
# inverse on consecutive runs, so it now reports a RATE and compares two arms.
CACHE_GATE_TRIALS=
# Skip caching below this many chars, on the AI-STUDIO (API key) backend.
# Gemini hard-rejects a cache under 1,024 tokens ("min_total_token_count=1024");
# default 6000 chars is a conservative stand-in. Every business shape clears it.
GEMINI_CACHE_MIN_CHARS=
# The same floor on VERTEX, which is FOUR TIMES higher (default 19000 chars).
#
# Measured 2026-08-30, gemini-3.6-flash at `global`: "The minimum token count to
# start explicit caching is 4096." countTokens over every fixture's real cache
# unit puts the LARGEST business shape at 3,967 tokens — 129 short. So explicit
# caching works on the current API-key deployment and engages for NOBODY on
# Vertex until the prompt grows or Google lowers the floor.
#
# The backend is detected from the SDK client, not from this variable, so
# nothing has to be set for the right floor to apply. Watch for
# `gemini_cache_below_vertex_floor` in the logs after the GCP cutover.
GEMINI_CACHE_VERTEX_MIN_CHARS=
# Treat a cache as dead this long before its TTL expires (default 60000).
GEMINI_CACHE_EXPIRY_MARGIN_MS=
# Back-off after a failed create, so a quota outage does not mean one failed
# API call per turn (default 600000).
GEMINI_CACHE_RETRY_COOLDOWN_MS=

# --- Text-channel tool calls (the 2026-08-04 "default_api" defect) -----------
# Gemini sometimes writes a function call into the TEXT channel instead of
# emitting a structured functionCall part:
#
#   default_api:reschedule_appointment_db{...} One moment while I update that for you.
#
# Two failures at once: nothing runs, and the caller hears the namespace read
# aloud ("default api reschedule appointment db"). With no tool result the model
# then invents plausible values — on the reported call, an appointment id that
# does not exist.
#
# Set to exactly "false" to mute such calls without asking the model to re-issue
# them properly. The caller's ear is protected either way; off means the action
# simply does not happen. Counters: text_channel_tool_calls (must be 0),
# text_channel_reasks, text_channel_unrecovered.
GEMINI_TEXT_CALL_RECOVERY=
# A turn that tells the caller it is checking or updating something and calls no
# tool at all must not end in silence. This is the deterministic layer — our
# code, not the model's judgement. It cannot fire on a legitimate "one moment"
# that preceded a real call, because any executed tool disables it. Set to
# exactly "false" to disable. Counters: promise_only_turns (must be 0),
# promise_only_unrecovered.
GEMINI_PROMISE_BACKSTOP=
# Tool-execution rounds allowed in one turn. Default 5, raised from 3 because a
# recovery round consumes one and a reschedule already needs up to four (lookup
# -> "which one?" -> re-lookup -> reschedule). Beyond 5 the turn is pathological
# and recovery, not more rounds, is the right answer. Hitting the cap logs
# fc_round_cap_hit rather than silently dropping the model's pending calls.
GEMINI_MAX_FC_ROUNDS=

# --- Engine-owned tool acknowledgement --------------------------------------
# "Let me check the diary for you." Spoken the INSTANT a tool starts, as a
# pre-rendered clip in the business voice, straight onto the audio queue.
#
# It is an ACKNOWLEDGEMENT, not a gap-filler, and the distinction is the whole
# design. As a gap-filler (fired 600ms in) it could not work: the line takes
# ~1.5s to say, audio plays serially, and the gap it covered measures 833ms p50
# -- so it landed just before the answer and made those turns LONGER. A caller
# reported exactly that. Fired immediately it is simply the pause itself, the
# way it is when a person says "let me check" and then looks something up;
# answering 200ms after those words is what sounds fake.
#
# Set to exactly "false" to disable. Costs ~0.5s per tool turn.
VOICE_ENGINE_FILLER=
# How long a tool round may run before the caller is told to hold. DEFAULT 0 --
# speak the moment the tool is known, which is the earliest a CORRECT line can
# exist. Was 1500 until 2026-08-31.
#
# The 1500 was derived from llm_reply_after_tool_ms (685 722 734 764 794 818 827
# 835 861 ... 3133) on the reasoning that a line takes ~1.5s to say, so firing
# at T only helps if the answer arrives after T + 1.5s. What made it wrong was
# not the arithmetic but the premise: the chatter it was reverting came from
# tools that had no business speaking at all -- record_customer_request,
# end_call, request_transfer, set_call_intent. The commit that mapped every one
# of them to a SILENT line landed AFTER the commit that set 1500, and nobody
# re-derived the threshold against the smaller set of tools left over.
#
# What it cost was reported live: the hold line arriving ~3s after the caller
# stopped speaking. The threshold is not all of that, but it is the worst part,
# because the clock starts at the toolCall event -- after the model has already
# spent its round-trip. The model's thinking was being ADDED to the wait rather
# than counted toward it.
#
# The trade at 0, accepted deliberately: a turn whose answer was ~800ms away now
# carries a line in front of it and ends up longer. In exchange the caller is
# never in dead air and the line always names the work actually happening --
# which is the argument the engine-filler block above has made all along.
#
# Raise it if a live call reads as chatty. Unlike last time, there is now a
# hold_line_ms span and a hold_line_played log to raise it FROM.
VOICE_TOOL_HOLD_DELAY_MS=
# How long to hold back a leading sentence that is nothing but a wait line,
# while waiting to see whether a tool call follows it. Default 350ms, max 800,
# 0 disables and restores the old behaviour.
#
# Reported live: "Let me check our calendar" followed straight away by "I have
# booked your appointment." The engine's own lines were never wrong — they are
# keyed to the tool that actually started (lib/voice/strings.js). The wrong
# line is the MODEL's: it announces a wait before it has settled which tool it
# is calling, and shouldPlayHoldLine then suppresses the accurate line to avoid
# the two stacking. So the inaccurate one won by design.
#
# The gate holds that sentence, and if a tool call arrives in the window it
# throws it away and speaks the engine's line instead — immediately, not after
# VOICE_TOOL_HOLD_DELAY_MS, because the caller's only line has just been
# swallowed. Only sentences that are a promise and nothing else are ever held:
# a promise carrying a question is spoken untouched. Counters:
# hold_line_promise_swapped / hold_line_promise_kept.
VOICE_PROMISE_GATE_MS=
# How long after swallowing the model's promise before the engine speaks its
# replacement. Default 400ms, 0 restores speak-immediately.
#
# Whichever comes first wins: the model's own text cancels it, so a tool that
# answers instantly produces no line at all. Both reasons for the delay came
# from a live call. services/gemini.js yields the toolCall event AFTER the tool
# has run, so playing instantly announced work that had already finished — or
# been REFUSED, e.g. "Getting that scheduled now" a moment before the model
# asks for the spelling the gate was waiting on. And a deliberately-silent tool
# (set_call_intent, which fires on nearly every turn) does no work at all, so
# anything in front of the answer is chatter.
#
# Worst case before a hold line is VOICE_PROMISE_GATE_MS + this, ~750ms, still
# half the 1500ms a caller waits when the model volunteers nothing.
VOICE_PROMISE_SWAP_DELAY_MS=

# --- Tool execution bounds -------------------------------------------------
# Deadline for any single tool call. Default 8000ms, deliberately ABOVE
# WEBHOOK_TIMEOUT_MS and ATHENA_TIMEOUT_MS so those vendor-specific bounds fire
# first with their better-worded messages — this is the backstop for everything
# they do not cover (Supabase, pack logic, an adapter that forgets to bound
# itself). Must stay comfortably inside VOICE_LLM_HARD_TIMEOUT_MS or it can
# never fire. Counters: tool_timeouts (must be 0), tool_errors.
TOOL_TIMEOUT_MS=
# Transport deadline for every Supabase request. Default 6000ms, below
# TOOL_TIMEOUT_MS so the transport gives up first. This — not the JS-side race
# — is the only thing that actually CANCELS a query, and cancelling is what
# stops a reschedule landing in the database after the caller was told it
# failed (logged as tool_late_completion when it happens anyway).
SUPABASE_TIMEOUT_MS=

# SUPABASE_URL and SUPABASE_SERVICE_KEY are GONE, not merely undocumented.
# `@supabase/supabase-js` is no longer a dependency of this repo and nothing
# imports it; the data layer has connected to Postgres directly since A3, and
# `DATABASE_URL` is what decides whether this process has a database at all.
# tests/supabaseGone.test.js fails the build if either the package or an import
# of it comes back. SUPABASE_TIMEOUT_MS survives above only because
# services/db.js still honours it as a fallback name for DB_TIMEOUT_MS.

# ============================================================
# D1 — variables the code reads that this file did not document
# ============================================================
# Added 2026-08-21 by tests/envInventory.test.js, which now FAILS the build if
# this file and the code disagree in either direction.
#
# The old count of "95 in code vs 81 documented" was itself wrong: it grepped
# for `process.env.NAME` only, and missed both the modules that read an injected
# `env.NAME` object and everything read through the four local `envInt()`
# helpers. The real numbers were 118 and 83.

# --- Database (services/db.js). DATABASE_URL replaced SUPABASE_URL/SERVICE_KEY
# --- as the thing that decides whether this process has a database at all.
DATABASE_URL=
# Pool size. Sized for concurrent CALLS, not users — a call holds no connection
# between turns. Default 10.
DB_POOL_MAX=
# Server-side statement timeout, ms. Sized BELOW the tool timeout so the
# database gives up first and the tool layer reports a real error. Default 6000.
DB_TIMEOUT_MS=

# --- Where the shared call-state slice lives (lib/callState.js)
# pg | postgres | memory | memorystore. Default `memory`.
#
# SET THIS TO `pg` ANYWHERE MORE THAN ONE INSTANCE CAN RUN. `/twilio/status` is
# a plain HTTP POST, so on two instances it lands on one that never held the
# WebSocket; with the in-process store it reads empty state and silently
# produces no call summary, no missed-call notification, and a spam tag on every
# short call where the caller did speak. Nothing logs an error.
#
# `postgres`/`memorystore` are accepted because that is the vocabulary
# `var.call_state_store` uses in infra/terraform/. `memorystore` currently maps
# to the in-process Map and warns loudly — no Memorystore adapter exists, and
# the costing ($70-100/month) says not to buy one until a measurement asks for
# it. Three scalars written at call boundaries do not need it.
#
# `pg` shares services/db.js's existing pool, so it adds ZERO connections and
# does not move `instances x DB_POOL_MAX`. It requires migration 038 and refuses
# to boot without a database rather than falling back.
CALL_STATE_STORE=

# --- Compliance mode (lib/deploymentMode.js, lib/compliance.js)
# standard | hipaa. In `hipaa` the process REFUSES to construct ElevenLabs,
# Deepgram or the Gemini Developer API client, and refuses to boot if one of
# their credentials is even present. An unrecognised value stops the boot rather
# than defaulting, because `hippa` would silently run as `standard`.
DEPLOYMENT_MODE=

# --- Vertex AI (services/gemini.js). The API-key path is the Gemini Developer
# --- API, which the Google Cloud BAA does NOT cover; Vertex is the covered one.
# Explicit opt-in. NOT inferred from GOOGLE_CLOUD_PROJECT, which Cloud Run sets
# automatically — inferring would switch backends on deploy as a side effect.
VERTEX_ENABLED=
# `global`. Corrected 2026-08-28 — the previous text here said NEVER `global`
# and preferred `eu`, and that distinction was never measured.
#
# THE HOST DECIDES RESIDENCY, THE LOCATION IN THE PATH DOES NOT. `us`, `eu` and
# `global` are all reached on aiplatform.googleapis.com, and that host returned
# 200 for `locations/madeup-region-9`. The path segment is not validated, so a
# 200 on `locations/eu` is not evidence of EU processing. `eu` and `global` are
# the same call; `global` is simply the honest name for it.
#
# A REAL region is the only thing that pins one, and it pins a narrow model set
# with it. Probed 2026-08-28 on europe-west2-aiplatform.googleapis.com:
# gemini-2.5-flash serves, gemini-3.6-flash / 2.5-flash-lite / 2.5-pro all 404.
# So genuine UK-resident inference is available and costs the model — 2.5-flash
# scored 17-18/20 against 3.6-flash's 19/20, with no in-region fallback. Offered
# to the owner 2026-08-28 and declined in favour of behaviour parity, which
# makes the inference call a DISCLOSED international transfer: it needs a line
# in the privacy notice AND the Art. 30 record. Everything else — Cloud SQL,
# Deepgram (api.eu.deepgram.com), KMS, secrets, compute — stays in europe-west2.
#
# Re-probe the europe-west2 REGIONAL HOST monthly. A 3.x model arriving there is
# the trigger to switch, and it is this line plus the host rule in
# services/gemini.js.
#
# Setting a real region is allowed and logs `vertex_location_unproven` rather
# than failing — check GEMINI_MODEL is one that region serves, or the first turn
# of the first call 404s.
VERTEX_LOCATION=
# Set automatically by Cloud Run; only needed locally.
GOOGLE_CLOUD_PROJECT=

# --- Deepgram region (lib/voice/sttDeepgram.js)
# us | eu. NOT an account flag — a different base URL. The UK stack must set
# `eu` or its audio is processed in the US whatever the DPA says.
DEEPGRAM_REGION=

# --- Google Speech-to-Text v2 (lib/voice/sttGoogle.js). The BAA-covered STT,
# --- used whenever the compliance tier is `hipaa`. There is deliberately NO
# --- STT_PROVIDER variable: the provider follows the tier, because a provider
# --- flag copied between environments fails silently, and the silent failure
# --- is patient speech reaching a vendor with no BAA.
# A SINGLE region. NEVER `global` — a global endpoint may process audio in any
# region on earth, which voids both the HIPAA data-location control and the UK
# residency claim. sttGoogle.js refuses `global` outright. Default us-central1.
STT_LOCATION=
# Comma-separated codes used when a business speaks more than one language.
# "multi" is a Deepgram concept — one model that code-switches — and Google has
# no equivalent, so the set has to be named. Default en-US,es-US.
STT_MULTI_LANGUAGES=

# --- Email. Both services read THESE names; there is one set of credentials.
# Where owner notifications link to. No default on purpose: a hardcoded
# fallback is how a link quietly starts pointing somewhere wrong.
DASHBOARD_URL=
# NOTE: CONTACT_EMAIL is read by the DASHBOARD backend, not this service, so it
# is documented there rather than here. This file covers the voice server only.
# Set false ONLY to tolerate a self-signed SMTP certificate. Not for production.
SMTP_REJECT_UNAUTHORIZED=

# --- CORS. Comma-separated. Replaces the older singular CORS_ORIGIN, which the
# --- voice server read while the dashboard read the plural — setting the wrong
# --- one failed silently by allowing nothing extra.
CORS_ORIGINS=

# --- Logging (lib/logger.js)
# DEBUG | INFO | ERROR. Default INFO.
LOG_LEVEL=
# Comma-separated Twilio call SIDs to force DEBUG for, regardless of LOG_LEVEL.
DEBUG_CALL_IDS=

# --- Gemini generation (services/gemini.js). All optional; defaults in code.
GEMINI_MODEL=
GEMINI_TEMPERATURE=
GEMINI_MAX_OUTPUT_TOKENS=
GEMINI_THINKING_BUDGET=
GEMINI_HISTORY_MAX_TURNS=
# Feature flag for the intent round-trip marker.
VOICE_INTENT_MARKER=

# --- Voice tuning. Changing any of these invalidates the A0 latency baseline;
# --- re-measure rather than assume.
STT_ENDPOINTING_MS=
VOICE_PACED_PLAYOUT=
VOICE_LOOKAHEAD_MS=
VOICE_BARGE_FADE_MS=
VOICE_POST_BARGE_MAX_HOLD_MS=
VOICE_LLM_STALL_MAX=
# Echo guard (lib/voice/echoGuard.js) — how the assistant recognises its own
# voice coming back down the line. Cutoffs were echo, not endpointing.
VOICE_ECHO_MIN_TOKENS=
VOICE_ECHO_MIN_BIGRAMS=
VOICE_ECHO_MAX_NOVEL=
VOICE_ECHO_RETAIN_MS=

# ============================================================
# Development and test tooling only. Never set in production.
# ============================================================
# eval harness (npm run eval)
EVAL_JUDGE_MODEL=
EVAL_SIMCALLER_MODEL=
# scripts/seed-staging.js — one synthetic business so a test call reaches the
# receptionist instead of the unrouted-voicemail path. The script REFUSES to
# run unless CLOUD_SQL_DATABASE and CLOUD_SQL_INSTANCE both contain 'staging'.
# All five are optional; the defaults are the staging test line.
SEED_PHONE_NUMBER=
SEED_BUSINESS_NAME=
SEED_USER_EMAIL=
SEED_USER_ID=
# Turn caller-facing SMS follow-ups ON for the seeded staging business. "true"
# or absent. Exists because staging's Cloud SQL is private-IP only, so the
# alternative is Cloud SQL Studio plus remembering that `businesses` is under
# FORCE row-level security, where an unscoped UPDATE matches zero rows and
# reports success. O25's consent gate sits on top of this flag, not instead
# of it.
SEED_SMS_FOLLOWUP=

# scripts/import-tenant.js
#
# BASE64 of the tenant JSON to import — `{"business": {...}, "capabilities": [...]}`.
#
# Base64 and not plain JSON, and that is the whole reason this variable has the
# shape it does: `gcloud run jobs execute` splits BOTH `--args` and
# `--update-env-vars` on commas, and JSON is mostly commas. Custom delimiters
# were tried and broke on characters inside the payload. Base64's alphabet is
# A-Za-z0-9+/= and contains no comma, so it survives the transport intact.
#
# `--update-env-vars` on an execution is EXECUTION-SCOPED (verified), so passing
# this ad hoc leaves no drift on the job definition.
#
# CONFIG ONLY. The script refuses a payload naming calls, call_transcripts,
# appointments, customer_requests, sms_consents or phi_access_log — moving call
# history is a personal-data migration and needs its own decision.
IMPORT_TENANT_B64=

# scripts/test-buy-number.js, scripts/test-appointments.js
BUSINESS_ID=
TEST_PATIENT_NAME=
# Blind TTS A/B (scripts/voice-ab-blind.js, scripts/voice-ab-call.js). These
# name vendors that are NOT wired into the live call path — they exist so C5 can
# compare candidates by ear at 8kHz over a handset.
CARTESIA_VOICE_ID=
INWORLD_VOICE_ID=
GEMINI_TTS_VOICE=
LISTENING_TEST_NUMBER=

# ---------------------------------------------------------------------------
# Automatic logoff (HIPAA 164.312(a)(2)(iii))
# ---------------------------------------------------------------------------
# Ceiling, in whole minutes, on how old an access token may be — measured from
# its `iat` claim, checked only AFTER the auth backend has verified the
# signature. This bounds how long a token leaked through a log line or an open
# devtools panel keeps working. It does NOT bound the refresh chain; see
# lib/auth/sessionAge.js for what that would take.
#
# Usable below the token lifetime only because the dashboard refreshes once and
# retries on the resulting 401 (frontend src/authRetry.js), so an active person
# notices nothing and an idle browser — which sends no requests — ages out.
#
# Default 30. Set to 0 to disable; "off" has to be spelled 0, because a value
# that does not parse falls back to the default rather than silently becoming a
# one-minute ceiling.
SESSION_MAX_AGE_MINUTES=30

# ---------------------------------------------------------------------------
# Identity Platform (B3) — lib/auth/idToken.js, lib/auth/accessToken.js
# ---------------------------------------------------------------------------
# The GCP project that ISSUES staff ID tokens. Both halves of the verification
# come from it: `aud` must equal it, and `iss` must be
# https://securetoken.google.com/<this>.
#
# NOT the project this process runs in, and the two genuinely differ. Identity
# Platform is initialised once in `vetra-shared` and serves every stack; the
# voice server runs in `vetra-us-staging` or `vetra-us-prod`. Setting this to
# GOOGLE_CLOUD_PROJECT would compare against the wrong project and fail every
# login, after a deploy that changed nothing about auth.
#
# Unset means this process CANNOT verify a token and every authenticated route
# returns 401. lib/bootChecks.js says so at boot rather than leaving it to be
# discovered as a wall of failed logins.
#
# `securetoken` is ONE signer shared by every Firebase and Identity Platform
# project on earth, so a token from a stranger's free project carries a valid
# signature against the same keys. This value is the only thing separating that
# from a full session.
IDENTITY_PLATFORM_PROJECT_ID=

# Short-lived OAuth access token for the ONE-OFF user import
# (scripts/import-users.js). Not a deployment variable and not a secret to
# store: it is minted at the moment of use and expires in an hour.
#
#   IDP_ACCESS_TOKEN=$(CLOUDSDK_CONFIG=$HOME/.gcloud-vetratd gcloud auth print-access-token)
#
# The import needs a real OAuth credential rather than the browser API key,
# because `accounts:batchCreate` is an admin operation. Nothing else reads this,
# and no running service should ever have it set.
IDP_ACCESS_TOKEN=

# Voice used by the TTS measurement harnesses (scripts/tts-readback.js,
# scripts/voice-ab-blind.js) when comparing Google Cloud TTS. Dev-only — the
# live path picks its voice per business from config/voices.js, not from here.
# Default: en-US-Chirp3-HD-Aoede, which is what lib/voice/ttsStream.js speaks
# with, so the measurement matches production.
GOOGLE_TTS_VOICE=

# ---------------------------------------------------------------------------
# Credential-boundary CI gate (scripts/check-credential-boundary.js)
# ---------------------------------------------------------------------------
# Comma-separated GCP project IDs to check for non-covered vendor secrets before
# a deploy. THE US LANE ONLY — vetra-uk-prod legitimately holds ElevenLabs and
# Deepgram credentials (GDPR has no covered-products restriction; an Art. 28 DPA
# suffices), so listing it here would fail every UK deploy on a correct config.
#
# Read only when --project is not passed. Left unset, the script composes the
# US prod project ID from infra/terraform/terraform.tfvars, which is gitignored
# because this repository is public. In CI, set it.
VETRA_PHI_PROJECTS=

# ---------------------------------------------------------------------------
# Cloud SQL over private IP (lib/db/cloudSqlPool.js)
# ---------------------------------------------------------------------------
# Set by Terraform on Cloud Run; unset everywhere else. When CLOUD_SQL_INSTANCE
# is empty this whole path is inert and DATABASE_URL is used, which is what
# local development and every tests/db suite rely on.
#
# The connection NAME, not the instance name: project:region:instance. Getting
# that wrong fails at connect time with a not-found that reads like a
# permissions problem, so it is validated up front.
CLOUD_SQL_INSTANCE=
# The database on that instance.
CLOUD_SQL_DATABASE=
# The Postgres role to connect as. For an IAM service account this is its email
# with `.gserviceaccount.com` REMOVED — Postgres caps identifiers at 63
# characters and Cloud SQL trims the suffix when it creates the user, so the
# full email names a user that exists and can never authenticate.
CLOUD_SQL_IAM_USER=
# PRIVATE (default) or PUBLIC. The instances are ipv4_enabled=false, so PUBLIC
# is not a fallback — anything unrecognised stays PRIVATE, deliberately, so a
# typo cannot open a path to a public endpoint.
CLOUD_SQL_IP_TYPE=

# ---------------------------------------------------------------------------
# C7 restore parity (scripts/c7-restore-parity.js) — SET PER EXECUTION, NEVER
# ON A SERVICE OR A JOB DEFINITION
# ---------------------------------------------------------------------------
# C7 restores a Cloud SQL automated backup into a scratch instance and compares
# it against the instance the backup came from. The script reaches the SOURCE
# through CLOUD_SQL_INSTANCE above — the migrate job already has it — and the
# RESTORED side through this.
#
# Pass it with `gcloud run jobs execute --update-env-vars`, which is
# EXECUTION-SCOPED: it does not stick to the job definition, so it creates no
# Terraform drift and the next migration run is unaffected. Setting it
# permanently would be a mistake, because the scratch instance is deleted as
# soon as the test is over.
#
# The connection name of the scratch instance: project:region:instance. If it
# resolves to the SAME instance as CLOUD_SQL_INSTANCE the script refuses to run
# rather than comparing a database with itself and reporting a perfect match.
C7_RESTORED_INSTANCE=
# Local rehearsal only, and it takes precedence over C7_RESTORED_INSTANCE: a
# libpq URL for a second database standing in for the restored one, so the
# script's own logic can be exercised without a Cloud SQL instance. Never set
# in a deployment — it carries a password, and the deployed path is passwordless
# IAM by design.
C7_RESTORED_URL=
# MIGRATIONS ONLY, from Secret Manager, and the application must never set it.
# Its presence switches from IAM auth to password auth. Applying a schema needs
# CREATE on `public` and role creation; migration 029 makes vetra_app
# NOSUPERUSER NOBYPASSRLS precisely so the runtime cannot do those things, and
# RLS is decorative if the service connects as a role that can switch it off.
CLOUD_SQL_PASSWORD=
# MIGRATION JOB ONLY. After the migrations that define vetra_app, grant its
# privileges to this principal by role membership, so the runtime needs no
# password and still inherits a role that cannot bypass RLS. Not in a migration
# file because it is a service account email that differs per environment.
CLOUD_SQL_GRANT_APP_ROLE_TO=

# ---------------------------------------------------------------------------
# Staging caller allowlist (lib/callerAllowlist.js)
# ---------------------------------------------------------------------------
# Comma-separated E.164 numbers permitted to reach this deployment. Everyone
# else hears "this number is not in service" and is hung up on, before anything
# looks up a business or touches the database.
#
# UNSET IN PRODUCTION. Absence means no restriction, and that direction is the
# safe one — a control that failed closed in production would refuse real
# patients, which is the outage it exists to prevent causing.
#
# SET ON STAGING, and set deliberately even if empty: staging shares a Twilio
# account with production, so a patient misdialling by one digit could otherwise
# reach an environment whose residency is not enforced and whose database sits
# outside the production backup and retention story.
#
# Entries must be E.164 (+ then 1-15 digits) because that is what Twilio
# delivers in `From`. A malformed entry can never match, so the boot refuses
# rather than leaving an allowlist that looks configured and admits nobody.
CALLER_ALLOWLIST=

# ---------------------------------------------------------------------------
# C8 cross-tenant isolation probe (scripts/c8-tenant-isolation.js)
# ---------------------------------------------------------------------------
# NOT read by any server. These are the defaults for a VERIFICATION script that
# is run by hand against a DEPLOYED dashboard API, and both have --api /
# --api-key flags that take precedence. They are documented here because
# tests/envInventory.test.js fails on any variable the code reads and this file
# does not describe — which is exactly what caught them, and is the gate
# working rather than a nuisance.
#
# The script CREATES ACCOUNTS AND TENANTS, so it refuses to run unless the API
# hostname contains "staging".
#
# C8_API_KEY is the Identity Platform WEB key. It is public by design — it
# identifies the project, authorises nothing, ships inside the JavaScript
# bundle, and Terraform restricts it to identitytoolkit. It is not a secret and
# putting it here is not a leak.
C8_API=
C8_API_KEY=

# How many times ONE call may ask the caller to spell something. Default 3,
# 0 forbids it entirely. This is a counter in code because the prompt-level cap
# does not hold: capabilities/appointments.js has said "ask this at most once"
# throughout, and the eval suite still caught the model asking "could you spell
# your last name?" on nine consecutive turns in 2 of 5 runs, with every hard
# assert green.
#
# Raised 1 -> 3 on 2026-08-31, when this stopped being the policy and became
# the outer backstop. At 1 it was the only thing between the caller and a
# mis-spelled record, and it closed on OUR question rather than THEIR answer —
# so a caller who was asked and simply talked about something else had their
# mis-heard name written down, and nothing in the call could tell that apart
# from a caller who had spelled it perfectly. What ends the asking now is
# VOICE_SPELL_MISS_CAP below.
VOICE_SPELL_ASK_CAP=
# How many spelling requests may go UNANSWERED before the call gives up and
# writes the name as heard. Default 2, 0 means never block for a spelling.
#
# This is the escape hatch that makes the block safe to be a hard one. A caller
# who cannot or will not spell — a bad line, a distracted parent, someone who
# talks straight past the question — must still be able to book. An explicit
# refusal settles immediately and does NOT consume one of these; only an answer
# that was neither letters nor a no does.
VOICE_SPELL_MISS_CAP=

# --- Round 2: turn-taking, from the 2026-08-27 live call -------------------
# Hold (ms) when the caller stops on a word that needs an object — "I'd like to
# book", "Can I get", "I've been having". Default 800 since 2026-08-31; 0
# disables. This is the fix for "it comes in too early when the caller is
# thinking": Deepgram's smart_format PUNCTUATES those fragments, so without this
# they read as finished sentences and get no hold at all. Verify with
# `npm run sim:cutoff` — the punctuated row goes 50.0% -> 12.5% cutoffs while
# the fluent control keeps 0 cutoffs and the same reply latency.
#
# It shipped at 0 in round 2 so the branch could land without behaviour risk,
# and then stayed off through all of round 3 — the cheap half of semantic
# end-of-turn detection, written and tested and switched off in production. The
# reason it costs a fluent caller nothing is that the rule sits ABOVE the
# punctuation branch and only matches fragments ending on a word that needs an
# object, so a caller speaking in whole sentences never reaches it. That is
# what makes it different from raising a blanket hold, which buys the same
# accuracy by charging every caller for it.
VOICE_HOLD_TRAILING_MS=
# Semantic end-of-turn detection: ask a small model whether the caller has
# actually finished, instead of only timing their silence. "true" to enable;
# anything else, including unset, leaves it OFF. SHIPPED DARK — nothing runs on
# a real call until this is switched on deliberately.
#
# It is an ACCURACY fix, not a latency fix, and should never be sold as one.
# Measured voice-to-voice p50 is 3,062ms and endpointing plus hold is roughly
# 500-650ms of it, so even perfect turn detection is worth a couple of hundred
# milliseconds. What it buys is spending the wait on the turns that need it:
# a hold cannot out-wait a caller who pauses two seconds mid-sentence, and
# sizing one as though it could is what makes the fluent caller pay for the
# hesitant one (800ms -> 3 barge-ins at p50 2,322ms; 1,200ms -> 2 at 2,663ms).
#
# The judge runs CONCURRENTLY with the hold that was going to run anyway and
# can only shorten or extend it. A late, failed or unparseable answer means no
# opinion and the timer is untouched — there is no path where a caller waits on
# it. Only the ambiguous hold tiers are ever asked about (no_terminal_punctuation,
# trailing_incomplete, partial_digits), so a fluent caller's turns cost nothing.
#
# Before enabling on real traffic: this is the first thing in the pipeline that
# puts a model call in the hot path of an ordinary turn, and its per-call cost
# has NOT been measured. Counters semantic_endpoint_flushed / _extended both
# sitting at zero with this on does not mean the model agreed with us — it
# means no verdict ever arrived inside its hold, which is the failure to watch
# for, because failing open makes "too slow" look exactly like "not needed".
VOICE_SEMANTIC_ENDPOINT=
# Throw away a half-prepared reply when the caller turns out not to be finished,
# instead of queueing their continuation as a separate second turn. ON by
# default (set "false" to disable) — unlike the other turn-taking flags, because
# it only runs in a state that otherwise produces a guaranteed-wrong outcome.
# It refuses to fire once audio has played, once the model has started emitting
# words, or once a tool round has begun (that turn may already have booked
# something).
VOICE_ABORT_ON_RESUME=
# How many turns one caller utterance may cost. Each abort burns an LLM round
# trip; past this we queue instead, which always terminates. Default 2, 0 off.
VOICE_RESUME_ABORT_MAX=
# Ask the caller to spell a hard-to-transcribe name before it becomes a record.
# ON by default (set "false" to disable). A live call stored "Ayalavarapu" as
# "Ayalla Varpu" — and the assistant HAD said the surname back, which made no
# difference, because a spoken read-back cannot convey spelling. Costs at most
# VOICE_SPELL_MISS_CAP refused tool calls per call: the gate opens as soon as
# the caller has spelled it, declined to, or ignored the question that many
# times, so nobody is asked forever.
VOICE_CONFIRM_HARD_NAMES=
# WHICH names get a spelling ask. Changed 2026-08-29.
#   always (default) - any name not already on the caller's records, once per
#     call, immediately before it is written. Chosen because the difficulty
#     heuristic cannot see a CONFIDENT mis-hearing of a short name ("Scripps"
#     heard as "Smith"), and that row is just as wrong.
#   hard  - the pre-2026-08-29 behaviour: only names lib/nameQuality.js flags.
#     Set this if the extra turn proves more friction than it is worth on real
#     calls. It is one env change, no deploy.
#   off   - never ask.
# A caller whose name is already on file is never asked under ANY policy: the
# record IS the spelling, and asking again is the repetition callers noticed.
VOICE_SPELL_POLICY=

# ---------------------------------------------------------------------------
# Build identification (server.js) — what `GET /` reports as "Build: <sha>"
# ---------------------------------------------------------------------------
# Exists because Railway's dashboard reports the time of the last DEPLOY, and it
# redeploys on an environment-variable change without a new commit — so it read
# "deployed 19 minutes ago" while serving week-old code, and a test call was
# spent against it before the mismatch was spotted. Not a secret: the repo is
# public and a deploy's SHA leaks through behaviour anyway.
#
# RAILWAY_GIT_COMMIT_SHA and RAILWAY_GIT_BRANCH are INJECTED BY RAILWAY and are
# never set by hand. Nothing outside Railway provides them — on Cloud Run both
# are absent, so GIT_COMMIT_SHA below is the only one that will be set after the
# migration, and it has to be passed in at build or deploy time. Unset, all
# three are absent and `GET /` reports "Build: unknown" rather than failing.
RAILWAY_GIT_COMMIT_SHA=
RAILWAY_GIT_BRANCH=
# Manual fallback, read only when RAILWAY_GIT_COMMIT_SHA is absent.
GIT_COMMIT_SHA=

# --- Restore drill (scripts/restore-drill.js, ledger P26) -------------------
# Operator-only, never read by the running service. They exist so the drill can
# be pointed at a different project/region without editing the script.
#
# VETRA_SQL_INSTANCE_ORIGINAL has no default ON PURPOSE: --rollback refuses to
# guess it, because after a repoint nothing on the estate still records the
# original instance name, and guessing during an incident is how you point at
# the instance you were recovering FROM.
VETRA_PROJECT=
VETRA_REGION=
VETRA_SQL_INSTANCE_ORIGINAL=

# --- Operator scripts only (scripts/onboard-tenant.js). NOT read by the
# --- service; these exist so onboarding a tenant does not mean editing a
# --- script, and so the same command works against a second estate.
#
# All five have defaults that point at the UK production estate, so the normal
# case is to set none of them.
#
# The split is not arbitrary: Identity Platform lives in the CORE project and
# Cloud SQL is private-IP only in the UK project, so onboarding necessarily
# talks to two places — the auth half from a workstation, the database half as
# a Cloud Run job execution inside the VPC.
VETRA_AUTH_PROJECT=
VETRA_DB_PROJECT=
VETRA_DB_REGION=
VETRA_MIGRATE_JOB=
# Where the customer lands after setting their password.
VETRA_DASHBOARD_URL=

# ---------------------------------------------------------------------------
# Speech-to-speech front-end, tier 1 (docs/speech-to-speech-handoff.md §7 step 2)
#
# Read only by lib/voice/live/**, reached on POST /twilio/live-voice and
# wss://.../twilio/live-stream. The cascade's own routes are untouched and do
# not read anything in this block: a Live misconfiguration cannot reach a call
# that is answering on /twilio/voice.
#
# GEMINI_API_KEY (top of this file) is the model credential and belongs in
# Secret Manager, not here. MEDIA_STREAM_SECRET should be set EXPLICITLY when
# this path is used: lib/mediaStreamToken.js otherwise derives its signing key
# from TWILIO_AUTH_TOKEN, so changing Twilio account would silently invalidate
# every websocket token.
# ---------------------------------------------------------------------------

# Which surface serves the Live model: unset/anything = AI Studio, "vertex" =
# Vertex AI. AI Studio is the default because gemini-3.1-flash-live-preview
# exists ONLY there — Vertex serves one Live model
# (gemini-live-2.5-flash-native-audio) in europe-west1 and us-central1 only,
# and europe-west2 serves none at all. Flip this the day 3.1 ships GA on
# Vertex; that is the whole reason the client has a branch.
LIVE_SURFACE=

# Override the Live model. Default gemini-3.1-flash-live-preview. It is a
# PREVIEW model and will move, change or be withdrawn, which is what this is
# for.
LIVE_MODEL=

# ---------------------------------------------------------------------------
# Who decides the caller's turn ended — NOT DECIDED. Three arms, scored on the
# same calls, and nothing is locked until one beats the incumbent on a real
# handset (handoff §6).
#
#   vendor    the vendor's automaticActivityDetection.  INCUMBENT, DEFAULT.
#             Measured 1,325 ms from the caller falling silent to hearing a
#             reply, on a matched speakerphone call.
#   hangover  manual detection + a flat timer. What the spike ran: 2,246 ms on
#             the matched call, and ~900 ms of that gap is the timer itself.
#   hold      manual detection + classifyHold, which prices the wait from what
#             the caller actually said — 0 ms on a sentence ending in terminal
#             punctuation, 2,000 ms on a trailing conjunction. THE CANDIDATE.
#             It has never run in a Live front-end.
#
# An unrecognised value resolves to `vendor` rather than throwing: a typo in a
# deploy variable must not move a live call onto an unmeasured arm.
# ---------------------------------------------------------------------------
LIVE_TURN_END=

# ---------------------------------------------------------------------------
# LVX23's bisect knobs. Both default to production; see docs/lvx23-bisect.md.
#
# The bare spike -- ten-line prompt, no tools -- was recorded as "it sounds
# amazing". The production surface, same model with ten tools and a
# ~17,000-character prompt, produced a call with three bookings, a
# cancellation, a mid-booking hang-up and audible confusion. These move ONE
# variable at a time on the same handset.
#
# They are a measuring instrument, not a configuration. Nothing ships with
# either of them set.
# ---------------------------------------------------------------------------
#
# `none` declares no tools at all. The tool runner and its guards stay
# constructed, so the only thing that differs is what the model can see.
LIVE_TOOLS=

# `minimal` swaps the shared production prompt for lib/voice/live/minimalPrompt.js.
# That prompt is deliberately NOT the spike's: the spike's said the assistant
# had no tools and that "someone will confirm", and that wording alone
# suppressed phone-number read-back (backlog LVX4).
LIVE_PROMPT=

# Tool-execution rounds allowed in ONE model turn on the Live path. Default 5,
# clamped 1-8 -- the same shape and the same default as GEMINI_MAX_FC_ROUNDS,
# deliberately, because two drivers that disagree about how many rounds a turn
# may take behave differently on the same conversation.
#
# The Live tool loop previously had no bound at all: whatever the model asked
# for, it ran. Past the cap the calls are still ANSWERED, because a Live session
# holding an unanswered tool call does not error -- it waits, and the caller
# hears silence.
LIVE_MAX_TOOL_ROUNDS=

# Silence after the last voiced frame before the turn is called over, in ms.
# Used by the `hangover` arm as its timer, and by `vendor` for turn bookkeeping
# only (that arm sends no activity signals, so this cannot change what the
# caller hears — only where a turn boundary lands in the metrics).
#
# Default 1200, and that number is the SPIKE'S PLACEHOLDER, not a tuned value.
# It was chosen flat on purpose because classifyHold needs text and the arrival
# time of that text was the thing being measured. Choose it from a live-call
# round, not by editing this file.
LIVE_HANGOVER_MS=

# Silence required, in ms, before the `hold` arm will act on a classifyHold
# verdict at all. Default 300, matching lib/voice/inboundVad.js's own hangover.
LIVE_MIN_SILENCE_MS=

# The `hold` arm's backstop, in ms. Default 1200. It is the only arm whose turn
# end depends on a message arriving from the vendor: input transcription was
# measured at 113-360 ms across nine calls, which is not the same as cannot
# fail, and without this a transcription failure means the caller is never
# answered at all.
LIVE_HOLD_BACKSTOP_MS=

# Serve a specific business's config regardless of the number Twilio called.
#
# So a TEST number can answer with Digile Media's real prompt, real ten-tool
# surface and real appointments rows, WITHOUT repointing +441372656055 — which
# is a working demo people call, and pointing it at an unproven tier 1 with no
# fallback path is a bad afternoon. Unset in anything resembling production,
# where the dialled number is the tenant.
LIVE_BUSINESS_PHONE=

# Preset Live voice. Default Kore. The prebuilt voices (Puck, Charon, Kore,
# Fenrir, Aoede, Leda, Orus, Zephyr, ...) are documented by NAME and not by
# accent, so which of them reads as British is decided by ear, not from docs.
LIVE_VOICE=

# BCP-47 code for synthesis. Default en-GB.
#
# The handoff asserted from vendor documentation that Live native audio refuses
# an explicit language code and only auto-detects. That is FALSE as written:
# en-GB was accepted on 9 of 9 spike calls with no error and no fallback, which
# is why the claim now sits in the retraction table. Accepted is not honoured,
# and the client still retries without it if a future model revision refuses,
# recording which happened per call.
LIVE_LANGUAGE_CODE=

# A SECOND Twilio auth token whose signatures the Live routes also accept.
#
# There are two Twilio accounts and GCP holds one token, so a number on the
# other account cannot be signature-validated with a single-token check. That
# is the corner the spike was backed into: it gave up on signatures and gated
# its webhook on a secret URL path instead (backlog LVX3). Defensible for a
# bare audio bridge that lived one day; not defensible for a front-end with
# appointment writes behind it.
#
# Read ONLY by /twilio/live-voice. The cascade's own validation stays
# single-token: widening what a paying clinic's route accepts, for the benefit
# of a route it does not use, is not a trade worth making.
TWILIO_AUTH_TOKEN_ALT=
