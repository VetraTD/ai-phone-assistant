node_modules
.env
ngrok.yml
.claude
.cursor
# Local voice preview audio (generated by scripts/verify-voices.js)
voice-previews/
# Eval suite run artifacts (eval/run.js writes <ISO-ts>.json here)
eval/results/
# Latency probe: synthesized caller audio and per-run measurements.
# Audio is regenerable (scripts/latency-probe.js --synth) and runs are
# environment-specific, so neither belongs in the repo.
test-audio/
latency-runs/
# Blind TTS A/B answer keys — committing one would defeat the blinding
# for anyone who reads the repo before listening.
**/answer-key.json
# Playwright MCP session artifacts (console dumps, page snapshots)
.playwright-mcp/
# Local UI review screenshots from the website rebuild — kept on disk as a
# visual record, but they are build output, not source.
/v-*.png
/landing-*.png
# Every other .env variant, not just the bare one. .env.staging sat untracked
# in a PUBLIC repo carrying a live TWILIO_ACCOUNT_SID and TWILIO_AUTH_TOKEN —
# one `git add -A` from publishing working credentials for the account the
# phone numbers are billed against.
.env.*
!.env.example
# Terraform state. It records service-account identities, resource ids and
# whatever values passed through the apply, and it is regenerated per
# environment, so it is never something to commit. NOT `infra/` wholesale:
# infra/ is genuinely tracked on the GCP lane branches, and ignoring the
# directory would silently swallow new .tf files there.
*.tfstate
*.tfstate.*
# Terraform plan files embed resource attribute values in PLAINTEXT, including
# ones that came from secrets, so a .tfplan is a credential-shaped artifact even
# though it looks like a build product. Provider binaries are hundreds of MB of
# vendored .exe and are re-fetched by `terraform init`.
*.tfplan
.terraform/

