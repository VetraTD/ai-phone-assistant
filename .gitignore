node_modules
.env
# Every .env VARIANT, not just `.env`. Only the bare name was listed, so a
# `.env.staging` or `.env.production` holding real credentials would have been
# committed — to a PUBLIC repository. Found while about to tell someone to
# create exactly such a file.
.env.*
!.env.example
ngrok.yml
.claude
.cursor
# Local voice preview audio (generated by scripts/verify-voices.js)
voice-previews/
# Eval suite run artifacts (eval/run.js writes <ISO-ts>.json here)
eval/results/
# Latency probe: synthesized caller audio and per-run measurements.
# Audio is regenerable (scripts/latency-probe.js --synth) and runs are
# environment-specific, so neither belongs in the repo.
test-audio/
latency-runs/
# Blind TTS A/B answer keys — committing one would defeat the blinding
# for anyone who reads the repo before listening.
**/answer-key.json
# Playwright MCP session artifacts (console dumps, page snapshots)
.playwright-mcp/
# Local UI review screenshots from the website rebuild — kept on disk as a
# visual record, but they are build output, not source.
/v-*.png
/landing-*.png
eval/results/tts-readback/
