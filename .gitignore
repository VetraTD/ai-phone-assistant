node_modules
.env
# Every .env VARIANT, not just `.env`. Only the bare name was listed, so a
# `.env.staging` or `.env.production` holding real credentials would have been
# committed — to a PUBLIC repository. Found while about to tell someone to
# create exactly such a file.
.env.*
!.env.example
ngrok.yml
.claude
.cursor
# Local voice preview audio (generated by scripts/verify-voices.js)
voice-previews/
# Eval suite run artifacts (eval/run.js writes <ISO-ts>.json here)
eval/results/
# Latency probe: synthesized caller audio and per-run measurements.
# Audio is regenerable (scripts/latency-probe.js --synth) and runs are
# environment-specific, so neither belongs in the repo.
test-audio/
latency-runs/
# Blind TTS A/B answer keys — committing one would defeat the blinding
# for anyone who reads the repo before listening.
**/answer-key.json
# Playwright MCP session artifacts (console dumps, page snapshots)
.playwright-mcp/
# Local UI review screenshots from the website rebuild — kept on disk as a
# visual record, but they are build output, not source.
/v-*.png
/landing-*.png
eval/results/tts-readback/
# Every other .env variant, not just the bare one. .env.staging sat untracked
# in a PUBLIC repo carrying a live TWILIO_ACCOUNT_SID and TWILIO_AUTH_TOKEN —
# one `git add -A` from publishing working credentials for the account the
# phone numbers are billed against.
.env.*
!.env.example
# Terraform state. It records service-account identities, resource ids and
# whatever values passed through the apply, and it is regenerated per
# environment, so it is never something to commit. NOT `infra/` wholesale:
# infra/ is genuinely tracked on the GCP lane branches, and ignoring the
# directory would silently swallow new .tf files there.
*.tfstate
*.tfstate.*
# Terraform plan files embed resource attribute values in PLAINTEXT, including
# ones that came from secrets, so a .tfplan is a credential-shaped artifact even
# though it looks like a build product. Provider binaries are hundreds of MB of
# vendored .exe and are re-fetched by `terraform init`.
*.tfplan
.terraform/
# tfvars is per-environment input, not source. This one carries the billing
# account id, org id and owner email addresses — no credential today, but it is
# the file that would grow one. Untracked on every branch, so ignoring it
# changes nothing except that a stray `git add -A` can no longer publish it.
*.tfvars
!*.tfvars.example


# Vendor prices are account-specific and go stale; a committed rate is one
# nobody re-checks. See config/rates.example.json.
config/rates.json

# Rendered voice candidates (scripts/voice-compare.js). Audio, not source.
voice-compare/

# LVX81 drift takes (scripts/probes/voice-drift.mjs). Audio plus the blind
# mapping, which must not be committed where a rater could read it.
voice-drift/

# Scratch copies of the live-call server log, used when analysing a call.
# They contain LIVE_DEBUG_TRANSCRIPT output: assistant speech, caller names and
# phone numbers. Three of them reached a commit on 2026-09-06 via `git add -A`,
# which is LVX24 (caller data where it does not belong) in a new place.
.s*.log
.call*.log
.t*.log

# Impeccable (design tooling) - machine-local state
.impeccable/review/
.impeccable/live/
.impeccable/config.local.json
.impeccable/questions/
