# Dashboard backend — environment.
#
# Written 2026-08-21. This file did not exist, which the migration ledger
# recorded as a D1 gap: nobody deploying this service could know what it reads
# without grepping it. The root .env.example is enforced by
# tests/envInventory.test.js; this one is not yet, and that is the obvious next
# step rather than a reason to leave it undocumented.

# --- Database -------------------------------------------------------------
DATABASE_URL=postgres://vetra:vetra_local_dev@localhost:55432/vetra
# TLS is VERIFIED by default and skipped for localhost. Set only for a managed
# database whose CA is not in the container's trust store — it accepts any
# certificate any host presents, so it is named rather than hidden in a URL.
# DB_SSL_INSECURE=false
# PGSSLMODE=

# --- Auth -----------------------------------------------------------------
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Automatic logoff (HIPAA 164.312(a)(2)(iii)). Ceiling in whole minutes on how
# old an access token may be. Default 30; 0 disables. See
# lib/auth/sessionAge.js in the repo root for what it does and does not bound.
SESSION_MAX_AGE_MINUTES=30

# --- HTTP -----------------------------------------------------------------
PORT=3001
NODE_ENV=development
# Comma-separated. CORS_ORIGIN is the deprecated singular, still honoured.
CORS_ORIGINS=
# CORS_ORIGIN=

# --- Email ----------------------------------------------------------------
# The contact form and the appointments digest return 503 until these are set.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM_EMAIL=
SMTP_REJECT_UNAUTHORIZED=true
CONTACT_EMAIL=
# Deliberately no default: a hardcoded fallback is how a link quietly starts
# pointing somewhere wrong.
DASHBOARD_URL=
