# Dashboard frontend — environment.
#
# Vite only exposes variables prefixed VITE_, and everything here is baked into
# the built bundle and therefore PUBLIC. Nothing secret belongs in this file.

# Identity Platform (B3). All three are PUBLIC — the API key identifies the
# project and authorises nothing, which is why it can ship in the bundle. It is
# restricted to identitytoolkit so a copy lifted out of the bundle cannot be
# spent on Vertex or Speech; see infra/terraform/identity-platform.tf.
#
# Read them from Terraform:  terraform output -json identity_platform
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_API_URL=http://localhost:3001
VITE_NUMBER_API_URL=
VITE_SITE_URL=

# Automatic logoff (HIPAA 164.312(a)(2)(iii)): minutes of no interaction before
# the session ends. 15 is the healthcare convention and the default. A warning
# appears two minutes before.
VITE_IDLE_TIMEOUT_MINUTES=15
