{
  "name": "ai-phone-assistant",
  "version": "1.0.0",
  "type": "module",
  "description": "An intelligent AI-powered phone assistant designed to handle calls, take messages, and more using natural language processing.",
  "main": "index.js",
  "scripts": {
    "start": "node server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:appointments": "node scripts/test-appointments.js",
    "test:athena-token": "node scripts/test-athena-token.js",
    "chat": "node scripts/chat.js",
    "eval": "node eval/run.js",
    "eval:compare": "node scripts/eval-compare.js",
    "probe:synth": "node scripts/latency-probe.js --synth",
    "probe": "node scripts/latency-probe.js",
    "probe:report": "node scripts/latency-probe.js --report-only",
    "voice:ab": "node scripts/voice-ab-blind.js",
    "voice:ab:call": "node scripts/voice-ab-call.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/VetraTD/ai-phone-assistant.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "engines": {
    "node": ">=18.0.0"
  },
  "bugs": {
    "url": "https://github.com/VetraTD/ai-phone-assistant/issues"
  },
  "homepage": "https://github.com/VetraTD/ai-phone-assistant#readme",
  "devDependencies": {
    "supertest": "^7.0.0",
    "vitest": "^2.0.0"
  },
  "dependencies": {
    "@deepgram/sdk": "^5.0.0",
    "@google-cloud/text-to-speech": "^6.4.0",
    "@google/genai": "^1.0.0",
    "@sentry/node": "^9.0.0",
    "@supabase/supabase-js": "^2.97.0",
    "cors": "^2.8.6",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "express-rate-limit": "^8.3.1",
    "helmet": "^8.1.0",
    "nodemailer": "^8.0.2",
    "twilio": "^5.0.0",
    "ws": "^8.20.0"
  }
}
