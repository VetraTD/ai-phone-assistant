# Copy to terraform.tfvars and fill in. terraform.tfvars is gitignored.
#
# Everything here is an identifier, not a credential — none of it grants access
# on its own. It is gitignored anyway, because this repository is public and
# there is no reason to publish a map of the account.

# vetratd.com. Numeric, not the domain. Confirm with:
#   CLOUDSDK_CONFIG=~/.gcloud-vetratd gcloud organizations list
org_id = "564252011558"

# Confirm with:
#   CLOUDSDK_CONFIG=~/.gcloud-vetratd gcloud billing accounts list
billing_account = "01C71E-7C0893-377AE9"

# The project Terraform routes its own API calls through for quota and billing.
#
# This is `vetra-shared`, NOT the trial-signup project. The signup project was a
# stand-in for the window before the six projects existed; that window closed.
# Pointing here also removes O3c's trap, where deleting the signup project
# breaks every future Terraform run.
#
# IT NEEDS THE APIS ENABLED ON IT. See the README's bootstrap section — a fresh
# project has none, and the failure reads as a permissions problem.
bootstrap_project_id = "vetra-shared-c3a3bd"

# Project IDs are IMMUTABLE and carry this suffix. It used to be a random value
# that existed only in Terraform state — and when B0a's state was lost, the
# config could no longer name its own projects. Pin it.
project_id_suffix = "c3a3bd"

# ---------------------------------------------------------------------------
# THE 6 -> 4 COLLAPSE. This block is the whole thing.
#
# The billing account caps at 5 linked projects and the trial-signup project
# holds one, leaving 4. Rather than defer the UK stack or buy support, two
# stacks the spec already calls "No PHI" were merged into projects that exist:
#
#   uk-staging -> us-staging   one staging project, both regions
#   logging    -> shared       log sinks land in the shared project
#
# `vetra-uk-staging-c3a3bd` and `vetra-logging-c3a3bd` STILL EXIST, UNBILLED.
# Do not delete them. An unbilled project costs nothing and does not touch the
# billing quota, so they are the restore path: relink, do not recreate.
#
# THE RESTORE IS DELETING TWO LINES FROM THIS BLOCK. When a slot frees — the
# quota is granted, or the signup project is deleted per O2e — take `logging`
# out first (sink configuration only, cheapest), then `uk-staging`.
#
# Omit the block entirely and the module's default is the six-project target.
#
# What the merge may NEVER touch: `us-prod` and `uk-prod`. A validation on this
# variable refuses it. That split is the credential boundary — `voice-us` holds
# no ElevenLabs key — and Cloud SQL instances and Identity Platform tenants
# cannot be moved between projects afterwards, so it would be close to
# permanent.
# ---------------------------------------------------------------------------
stack_projects = {
  us-prod    = "us-prod"
  us-staging = "us-staging"
  uk-prod    = "uk-prod"
  uk-staging = "us-staging" # MERGED — restore by deleting this line's override
  shared     = "shared"
  logging    = "shared"     # MERGED — restore this one FIRST
}

# A merged project should say so in the console. Matches the display name the
# project already carries.
project_display_names = {
  us-staging = "Vetra Staging - US and UK"
  shared     = "Vetra Shared - Log Sinks"
}

# ---------------------------------------------------------------------------
# ADOPTION — DONE 2026-08-21. Both emptied, and they stay empty.
#
# B0a applied partially and its local state was lost. The four projects and
# three org policies were adopted back with import blocks rather than recreated,
# and that apply has succeeded — `terraform plan` now reports no changes.
#
# Left in place, empty, because the next state loss is cheaper for the mechanism
# already being here: refill them, plan, apply. See imports.tf.
# ---------------------------------------------------------------------------
adopt_existing_projects = {}   # EMPTIED 2026-08-21 after the adoption apply

adopt_existing_org_policies = []  # EMPTIED 2026-08-21 after the adoption apply

# ---------------------------------------------------------------------------
# Cost controls. See cost-controls.tf for the reasoning behind each default;
# these are the ones worth stating explicitly because the value IS the decision.
# ---------------------------------------------------------------------------

# C-1. There is no UK clinic. The PROJECT exists either way — that is settled —
# but nothing goes inside it until one signs. Lane C's UK gates need this ON
# temporarily: flip it, apply, run the gates, destroy the UK resources, keep the
# project and the state.
enable_uk_resources = false

# C-5. Regional roughly doubles the instance cost, and HA is not a HIPAA
# requirement — §164.308(a)(7) is satisfied by PITR + backups + C7's restore
# test. Buy it when downtime costs more than the second instance.
cloud_sql_high_availability = false

# C-3. Postgres, not Memorystore. The shared call-state slice is three scalars
# written at call boundaries with zero per-turn reads.
call_state_store = "postgres"

# C-6. Never a Serverless VPC Access connector — those are real VMs at ~$30-40
# each, billed whether or not a packet crosses them.
cloud_run_vpc_egress = "direct"

# ---------------------------------------------------------------------------
# Principals.
# ---------------------------------------------------------------------------

# Full access to every project, including the ones that hold PHI.
owner_principals = [
  "user:admin@vetratd.com",
]

# Access to the shared project ONLY — Artifact Registry and Cloud Build. Never
# to a project that can hold patient data.
#
# Empty today: the cofounder does not access Google Cloud (ledger O20). If that
# changes, add them HERE rather than sharing admin@vetratd.com — shared
# credentials make audit logs unattributable and fail §164.312(a)(2)(i) and
# §164.312(b) at the same time.
shared_only_principals = []

# us_region = "us-central1"
# uk_region = "europe-west2"

# ---------------------------------------------------------------------------
# Essential Contacts — who Google tells when something is wrong.
#
# THIS WAS EMPTY UNTIL A SUSPENSION, and the notices that would have warned us
# had already been sent to a mailbox nobody was reading. Treat it as required,
# not optional: the free-trial expiry warns through the same channel and
# suspends projects.
#
# @vetratd.com ONLY. `essentialcontacts.managed.allowedContactDomains` is one of
# Google's secure-by-default managed constraints on this org, and a personal
# address is refused at apply time with "Operation denied by org policy". The
# variable validates the domain so you find out at plan time instead.
#
# ADD THE COFOUNDER. One contact is a single point of failure for the one class
# of message that arrives with a deadline attached.
essential_contacts = {
  "someone@vetratd.com" = {}
  # "cofounder@vetratd.com" = { categories = ["ALL"] }
}

# Contacts created outside Terraform, to be ADOPTED rather than recreated —
# Terraform errors on creating one that already exists. Read the ids with
#   gcloud essential-contacts list --organization=<org id>
# BLANK THIS ONCE APPLIED, same documented lifecycle as adopt_existing_projects.
adopt_existing_contacts = {}

# ---------------------------------------------------------------------------
# Image tags — PIN BOTH, NEVER LEAVE EITHER UNSET
# ---------------------------------------------------------------------------
# Missing from this file until 2026-08-23, which is exactly how
# `dashboard_image_tag` came to be unset in the real tfvars for its whole life:
# nothing here said it existed, so nothing prompted anyone to set it, and it
# fell back to its `latest` default. A floating tag has already cost three
# failed deploys where the container ran previous code and every failure looked
# like a real bug, because it was — in old code. It also makes a revision
# nobody can reproduce: "what was running on Tuesday" has no answer.
#
# The two are separate because the images have independent lifecycles: a
# dashboard change should not mint a new voice revision, or vice versa.
#
# Build, verify the image CONTAINS what you think (the tag is a hand-typed
# `_TAG` substitution on a source tarball, not a git ref — reading one has
# already produced a wrong answer here), then bump.
#
#   gcloud builds submit --config=cloudbuild.yaml #     --project=vetra-shared-c3a3bd #     --service-account=projects/vetra-shared-c3a3bd/serviceAccounts/vetra-deployer@vetra-shared-c3a3bd.iam.gserviceaccount.com #     --substitutions=_TAG=$(git rev-parse --short HEAD)
#
#   gcloud builds submit AI-phone-dashboard/backend --config=cloudbuild.dashboard.yaml ...
#
# ⚠ `image_tag` ALSO DRIVES THE MIGRATE JOB, not just the voice service, so one
# apply moves both — and updating a job does not RUN it. Apply the job on its
# own with -target, execute it, and only then apply the rest. Skipping that
# order serves code against a schema that has not been migrated yet.
image_tag           = "0000000"
dashboard_image_tag = "0000000"

# The number caller-facing SMS is sent FROM, per stack. E.164, and it must belong
# to the Twilio account THAT STACK authenticates as — staging uses a subaccount,
# so a production number here fails with 21606 and reads as a bad number.
#
# Unset = channel off, which is supported and announced at boot as
# `sms_channel_off`. Setting it does NOT mean a text arrives: a US long code
# needs A2P 10DLC and a toll-free number needs verification, shown per number in
# Twilio as Traffic Status `Messaging disabled` — independently of `Voice
# enabled`, so the same number can answer calls and refuse to text.
twilio_sms_from = {
  # "us-staging" = "+1XXXXXXXXXX"
}
